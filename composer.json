{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "durable-workflow/ai",
    "description": "Durable sandbox orchestration contracts and providers for AI agents.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "agents",
        "durable-workflow",
        "laravel",
        "sandbox",
        "workflow"
    ],
    "autoload": {
        "psr-4": {
            "DurableWorkflow\\AI\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "DurableWorkflow\\AI\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --testdox",
        "stan": "phpstan analyse src tests",
        "format": "pint --test"
    },
    "require": {
        "php": "^8.2",
        "durable-workflow/workflow": "^2.0@RC",
        "laravel/framework": "^12.61.1|^13.0"
    },
    "require-dev": {
        "laravel/pint": "^1.24",
        "orchestra/testbench": "^10.0|^11.0",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.0|^12.0"
    },
    "extra": {
        "durable-workflow": {
            "product-train": "2.0.0-rc.1",
            "contracts": {
                "sandbox-provider": "1.0"
            }
        },
        "laravel": {
            "providers": [
                "DurableWorkflow\\AI\\Laravel\\SandboxServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    }
}
